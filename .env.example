# Local preview: copy to .env. Leave unknown values blank.
# Production: use protected per-release configuration outside the public tree;
# see docs/CLAUDE-DEPLOYMENT.md. Do not commit actual credentials.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=
TRUST_PROXY=

# Direct SMTP only. False means STARTTLS is REQUIRED, never plaintext fallback.
# SMTP_FROM and SMTP_TO must each be one verified plain email address.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=

# Optional public account identifiers. Consent is still required before GA loads.
GA4_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Required for production; see docs/TRUTH-INTEGRATION.md.
# These reference the existing canonical source, not a new local entity graph.
TSC_TRUTH_PROJECTION=
TSC_TRUTH_COMMIT=
TSC_TRUTH_SHA256=

# Explicit independent owner choices required by build:production: allow or deny.
# Inspect existing policy first; no production decision is supplied for the owner.
AI_TRAINING_POLICY=
GOOGLE_EXTENDED_POLICY=
# Optional per-provider overrides; blank inherits AI_TRAINING_POLICY.
OPENAI_TRAINING_POLICY=
ANTHROPIC_TRAINING_POLICY=
MISTRAL_TRAINING_POLICY=
