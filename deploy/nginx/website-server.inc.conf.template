# Include inside the reviewed existing HTTPS server {} for thatstupidcomputer.com.
# Do not include beside an existing competing location /. Merge the exact diff.
# TLS certificate/key/listen settings stay in the verified existing server block.
# Replace __TSC_PRIVATE_ACCESS_LOG__ with a new approved restricted log file path.
server_tokens off;
access_log __TSC_PRIVATE_ACCESS_LOG__ tsc_private;
# Nginx request errors can include IP/URI/query values and cannot use log_format.
# Discard this vhost's error log; monitor finite status logs and safe application logs.
error_log /dev/null crit;
client_max_body_size 16k;
client_body_buffer_size 16k;
client_body_in_file_only off;
client_body_timeout 15s;
send_timeout 30s;
gzip on;
gzip_vary on;
gzip_min_length 1024;
gzip_comp_level 5;
gzip_proxied any;
gzip_types text/plain text/css text/javascript application/javascript application/json image/svg+xml application/wasm application/xml text/xml application/manifest+json;
# text/html is included by nginx automatically. Do not recompress binary images/fonts.

location / {
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    # Replace untrusted client forwarding headers; never append their values.
    # If an actual CDN/load balancer exists, first review the existing real-IP chain.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host "";
    proxy_set_header Forwarded "";
    proxy_set_header Connection "";
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_max_temp_file_size 0;
    proxy_cache off;
    proxy_store off;
    # An ambiguous SMTP response must never cause automatic POST replay.
    proxy_next_upstream off;
    proxy_intercept_errors off;
    proxy_connect_timeout 5s;
    proxy_send_timeout 30s;
    proxy_read_timeout 35s;
    proxy_redirect off;
}
