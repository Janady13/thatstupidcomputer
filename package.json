{
  "name": "thatstupidcomputer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ThatStupidComputer interactive website and direct-email service",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "discovery": "node --import tsx scripts/discovery.ts",
    "dev": "node scripts/dev.mjs",
    "build": "node --import tsx scripts/build.ts",
    "build:production": "node --import tsx scripts/build.ts --production",
    "preview": "node scripts/preview.mjs",
    "start": "node apps/api/dist/server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:browser": "playwright test",
    "verify": "npm run verify:local && npm run test:browser",
    "package": "node --import tsx scripts/package.ts",
    "test:assets": "node --import tsx scripts/audit-assets.ts",
    "test:architecture": "node scripts/check-architecture.mjs",
    "test:standards": "node --import tsx scripts/standards-inventory.ts --check",
    "verify:local": "node scripts/verify-local.mjs",
    "verify:production": "npm run typecheck && npm test && npm run build:production && npm run test:assets && npm run test:standards && npm run test:build && npm run test:browser",
    "test:build": "node --import tsx scripts/check-build.ts",
    "native:compile": "node scripts/compile-native.mjs",
    "native:verify": "node scripts/verify-native.mjs",
    "native:browser": "node scripts/native-harness-server.mjs",
    "native:wasm": "node scripts/sync-rive-wasm.mjs"
  },
  "dependencies": {
    "@fastify/formbody": "9.0.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.3",
    "@rive-app/react-webgl2": "4.34.2",
    "fastify": "5.12.4",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "motion": "13.2.0",
    "nodemailer": "10.0.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "react-router": "8.3.1",
    "web-vitals": "6.2.1",
    "xstate": "5.33.0",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@napi-rs/canvas": "1.0.9",
    "@playwright/test": "1.63.0",
    "@rive-app/canvas": "2.42.1",
    "@types/node": "24.13.4",
    "@types/nodemailer": "8.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@xmldom/xmldom": "0.9.12",
    "esbuild": "0.28.2",
    "jszip": "3.10.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
